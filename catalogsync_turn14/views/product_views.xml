<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_turn14" model="ir.ui.view">
        <field name="name">product.template.form.inherit.turn14</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="t14_item_id" readonly="1" invisible="not t14_item_id"/>
            </xpath>
        </field>
    </record>
    <record id="product_product_form_view_inherit_turn14" model="ir.ui.view">
        <field name="name">product.product.form.inherit.turn14</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="t14_item_id" readonly="1" invisible="not t14_item_id"/>
            </xpath>
        </field>
    </record>
    <record id="product_supplierinfo_form_view_inherit_turn14" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.inherit.turn14</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml"><xpath expr="//group[@name='vendor']" position="inside"/></field>
    </record>
</odoo>
