<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Catalog Sync Cron -->
        <record id="ir_cron_turn14_daily_catalog_sync" model="ir.cron">
            <field name="name">Turn 14: Daily Catalog Items Sync</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._cron_t14_import('items')</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <!-- 15-minute Inventory Snapshot Cron -->
        <record id="ir_cron_turn14_inventory_sync" model="ir.cron">
            <field name="name">Turn 14: Regular Inventory Sync</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._cron_t14_import('inventory')</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
