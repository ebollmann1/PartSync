<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="form_view_request_upload_customers" model="ir.ui.view">
            <field name="name">Upload Customers</field>
            <field name="model">upload.customers</field>
            <field name="arch" type="xml">
                <form create="0" js_class="ebiz_custom_form" string="Upload Customers">
                    <h1>Upload Customers</h1>
                    <br/>
                    <group>
                        <group>
                            <label class="text-nowrap" for="ebiz_profile_id" string="EBizCharge Merchant Account"/>
                            <field name="ebiz_profile_id" nolabel="1" />
                        </group>
                        <group>
                            <button class="oe_highlight" context="{'button_pressed': True}" name="create_default_records" string="Refresh" style="height: 25px;padding-top: 3px;" type="object"/>
                            <field invisible="1" name="company_ids"/>
                        </group>
                    </group>
                    <notebook colspan="3">
                        <page string="List">
                            <field class="mt-3 notebook_width" invisible="not transaction_history_line" mode="list" name="transaction_history_line" widget="x2many_selection_actions">
                                <list create="false" delete="false" limit="15" no_open="1" string="Transaction Lines">
                                    <header>
                                        <button class="btn-primary" name="upload_customers" type="object" string="UPLOAD"/>
                                        <button class="btn-primary" name="export_customers" type="object" string="EXPORT"/>
                                        <button class="btn-primary" name="delete_customers" type="object" string="DEACTIVATE"/>
                                    </header>
                                    <field column_invisible="1" name="id" readonly="1"/>
                                    <field name="customer_id" readonly="1"/>
                                    <field name="email_id" readonly="1"/>
                                    <field name="customer_phone" readonly="1"/>
                                    <field name="street" readonly="1"/>
                                    <field name="customer_city" readonly="1"/>
                                    <field name="country" readonly="1"/>
                                    <field name="last_sync_date" readonly="1"/>
                                    <field name="sync_status" readonly="1"/>
                                </list>
                            </field>
                            <div invisible="transaction_history_line">
                                <div class="empty_div_setting">
                                    <div class="o_view_nocontent">
                                        <div class="o_nocontent_help">
                                            <p class="o_view_nocontent_smiling_face" style="margin-top: 60%;">
                                                No Customer(s) Found.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="Logs">
                            <field class="mt-3 notebook_width" invisible="not logs_line" mode="list" name="logs_line" widget="x2many_selection_actions">
                                <list create="false" delete="false" limit="15" no_open="1" string="Transaction Lines">
                                    <header>
                                        <button class="btn-primary" name="export_logs" type="object" string="EXPORT"/>
                                        <button class="btn-primary" name="clear_logs" type="object" string="CLEAR LOG"/>
                                    </header>
                                    <field column_invisible="1" name="id" readonly="1"/>
                                    <field name="customer_id" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="street" readonly="1"/>
                                    <field name="email_id" readonly="1"/>
                                    <field name="customer_phone" readonly="1"/>
                                    <field name="last_sync_date" readonly="1"/>
                                    <field name="sync_status" readonly="1"/>
                                </list>
                            </field>
                            <div invisible="logs_line">
                                <div class="empty_div_setting">
                                    <div class="o_view_nocontent">
                                        <div class="o_nocontent_help">
                                            <p class="o_view_nocontent_smiling_face" style="margin-top: 96%;">
                                                No Record(s) Found.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="action_res_partner_upload_customers" model="ir.actions.server">
            <field name="name">Upload Customers</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="payment_ebizcharge_crm.model_upload_customers"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_upload_customers()</field>
        </record>

        <menuitem action="action_res_partner_upload_customers" id="menu_ebiz_upload_res_partner" name="Upload Customers" parent="ebiz_upload_menu_main" sequence="1"/>
    </data>
</odoo>
