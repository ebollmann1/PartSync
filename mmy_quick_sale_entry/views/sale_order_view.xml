<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <menuitem
        id="quick_entry_sales_order"
        name="Quick Entry Sales Order"
        web_icon="mmy_quick_sale_entry,static/description/icon.png"
        sequence="0"
    />

    <record id="sale_order_action_quick_entry" model="ir.actions.act_window">
        <field name="name">Quick Entry Sales Order</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[]</field>
        <field name="context">{'validate_invoice_delivery': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new quotation, the first step of a new sale!
            </p><p>
            Once the quotation is confirmed by the customer, it becomes a sales order.<br/> You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <menuitem
        id="quick_sales_order"
        name="Quick Entry Sales Order"
        parent="mmy_quick_sale_entry.quick_entry_sales_order"
        action="mmy_quick_sale_entry.sale_order_action_quick_entry"
        groups="mmy_quick_sale_entry.show_quick_entry_sales_order_menu"
    />
</odoo>