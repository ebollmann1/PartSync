<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_customer_product_master_form" model="ir.ui.view">
        <field name="name">import.customer.product.master</field>
        <field name="model">import.customer.product.master</field>
        <field name="arch" type="xml">
            <form string="Customer Product Master">
                <p>We Import XLS File. Please follow file header name.</p>
                <p></p>
                <p>1. Brand ID/Customer Code</p>
                <p></p>
                <p>2. Product (Internal Reference)</p>
                <p></p>
                <p>3. Year</p>
                <p></p>
                <p>4. Make</p>
                <p></p>
                <p>5. Model</p>
                <p></p>
                <p>6. Submodel</p>
                <p></p>
                <p>7. Wheel Configuration</p>
                <p></p>
                <p>8. Vehicle Platform</p>
                <p></p>
                <br/>
                <group>
                    <field name="product_type" required="1"/>
                    <field name="xls_file" required="1" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="import_data" type="object" string="Import"
                            class="btn-primary custom-color-btn-primary"/>
                    <button special="cancel" string="OK" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_import_customer_product_master">
        <field name="name">Customer Product Master</field>
        <field name="res_model">import.customer.product.master</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem name="Import Product Fitment Mapping" id="menu_import_customer_product_master"
              parent="menu_mmyauto_apps" action="action_import_customer_product_master"
              sequence="170"/>
</odoo>
