<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- vehicle.platform -->
    <record id="vehicle_information_form_view" model="ir.ui.view">
        <field name="name">vehicle.information.form</field>
        <field name="model">vehicle.information</field>
        <field name="arch" type="xml">
            <form string="Vehicle Platform">
                <sheet>
                    <group>
                        <group>
                            <field name="tag"/>
                            <field name="state"/>
                            <field name="mileage"/>
                            <!-- <field name="fitmen_master_id"/> -->
                            <field name="make"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="submodel"/>
                            <field name="rear_wheels"/>
                        </group>
                        <group>
                            <field name="tire_size_front"/>
                            <field name="tire_size_rear"/>
                            <field name="engine_type"/>
                            <field name="vin_number"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vehicle_information_tree_view" model="ir.ui.view">
        <field name="name">vehicle.information.tree</field>
        <field name="model">vehicle.information</field>
        <field name="arch" type="xml">
            <list string="Vehicle Platform">
                <field name="tag"/>
                <field name="state"/>
                <field name="mileage"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="submodel"/>
                <field name="rear_wheels"/>
            </list>
        </field>
    </record>

    <record id="vehicle_information_action" model="ir.actions.act_window">
        <field name="name">Vehicle information</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vehicle.information</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
    </record>

    <record id="view_partner_form_inherited" model="ir.ui.view">
        <field name="name">res.partner.from</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="vehicle_information" string="Vehicle Information" invisible="not show_vehicle_page">
                    <field name="vehicle_info_ids">
                        <list string="Vehicle Platform">
                            <field name="tag"/>
                            <field name="state"/>
                            <field name="mileage"/>
                            <field name="make"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="submodel"/>
                            <field name="rear_wheels"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="tag"/>
                                        <field name="state"/>
                                        <field name="mileage"/>
                                        <!-- <field name="fitmen_master_id"/> -->
                                        <!-- <field name="make_id"/> -->
                                        <field name="make"/>
                                        <field name="model"/>
                                        <field name="year"/>
                                        <field name="submodel"/>
                                        <field name="rear_wheels"/>
                                    </group>
                                    <group>
                                        <field name="tire_size_front"/>
                                        <field name="tire_size_rear"/>
                                        <field name="engine_type"/>
                                        <field name="vin_number"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
                <page name="partner_invoice_history_ids" string="Partner Transaction History">
                    <field name="partner_invoice_history_ids" readonly="1">
                        <list string="Transaction History">
                            <field name="type"/>
                            <field name="inv_type"/>
                            <field name="date"/>
                            <field name="number"/>
                            <field name="memo"/>
                            <field name="name"/>
                            <field name="item"/>
                            <field name="qty" sum="Quantity"/>
                            <field name="sales_price" sum="Sales Price"/>
                            <field name="amount" sum="Amount"/>
                            <field name="balance" sum="Balance"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="type"/>
                                        <field name="inv_type"/>
                                        <field name="date"/>
                                        <field name="number"/>
                                        <field name="memo"/>
                                        <field name="name"/>
                                        <field name="item"/>
                                    </group>
                                    <group>
                                        <field name="qty"/>
                                        <field name="sales_price"/>
                                        <field name="amount"/>
                                        <field name="balance"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_project_form_inherited" model="ir.ui.view">
        <field name="name">project.project.from</field>
        <field name="model">project.project</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="inside">
                <field name="show_vehicle_page" invisible="1"/>
                <group invisible="not show_vehicle_page">
                    <group>
                        <field name="vehicle_info_id" domain="[('partner_id', '=', partner_id)]"/>
                    </group>
                </group>
                <!--<group>-->
                    <div class="table-responsive">
                        <table style="width:100%!"
                               class="o_list_table table table-sm table-hover table-striped o_list_table_ungrouped">
                            <tr>
                                <th class="table_border">Tag</th>
                                <th class="table_border">State</th>
                                <th class="table_border">Mileage</th>
                                <th class="table_border">Make</th>
                                <th class="table_border">Model</th>
                                <th class="table_border">Year</th>
                            </tr>
                            <tr>
                                <td>
                                    <field name="tag" readonly="1"/>
                                </td>
                                <td>
                                    <field name="state" readonly="1"/>
                                </td>
                                <td>
                                    <field name="mileage"/>
                                </td>
                                <td>
                                    <field name="make" readonly="1"/>
                                </td>
                                <td>
                                    <field name="model" readonly="1"/>
                                </td>
                                <td>
                                    <field name="year" readonly="1"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                <!--</group>-->
            </xpath>
        </field>
    </record>
</odoo>
