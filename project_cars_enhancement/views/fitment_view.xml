    <!-- vehicle.platform -->
    <record id="vehicle_patform_form_view" model="ir.ui.view">
        <field name="name">vehicle.platform.form</field>
        <field name="model">vehicle.platform</field>
        <field name="arch" type="xml">
            <form string="Vehicle Platform">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vehicle_patform_tree_view" model="ir.ui.view">
        <field name="name">vehicle.platform.tree</field>
        <field name="model">vehicle.platform</field>
        <field name="arch" type="xml">
            <list string="Vehicle Platform">
                <field name="name" required="1"/>
            </list>
        </field>
    </record>

    <record id="vehicle_patform_action" model="ir.actions.act_window">
        <field name="name">Vehicle Platform</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vehicle.platform</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
    </record>

