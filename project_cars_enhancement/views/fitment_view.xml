    <!-- fitment.master -->
    <record id="fitment_master_form_view" model="ir.ui.view">
        <field name="name">fitment.master.form</field>
        <field name="model">fitment.master</field>
        <field name="arch" type="xml">
            <form string="Fitment Master">
                <sheet>
                    <group>
                        <group>
                            <field name="make_id" required="1"/>
                            <field name="model_id" required="1"/>
                            <field name="year_id" required="1"/>
                            <field name="submodel_id"/>
                            <field name="rear_wheels_id"/>
                            <field name="generation"/>
                            <field name="fitment_class"/>
                        </group>
                        <group>
                            <field name="vehicle_platform_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fitment_master_tree_view" model="ir.ui.view">
        <field name="name">fitment.master.tree</field>
        <field name="model">fitment.master</field>
        <field name="arch" type="xml">
            <list string="Fitment Master">
                <field name="make_id" required="1"/>
                <field name="model_id" required="1"/>
                <field name="year_id" required="1"/>
                <field name="submodel_id"/>
                <field name="rear_wheels_id"/>
                <field name="generation"/>
                <field name="fitment_class"/>
                <field name="vehicle_platform_id"/>
            </list>
        </field>
    </record>

    <record id="view_fitment_master_search" model="ir.ui.view">
        <field name="name">fitment.master.search</field>
        <field name="model">fitment.master</field>
        <field name="arch" type="xml">
            <search string="Fitment Master">
                <field name="make_id" string="Make" filter_domain="[('make_id','ilike', self)]"/>
                <field name="model_id" string="Model" filter_domain="[('model_id','ilike', self)]"/>
                <field name="year_id" string="Year" filter_domain="[('year_id','ilike', self)]"/>
                <field name="submodel_id" string="Submodel" filter_domain="[('submodel_id','ilike', self)]"/>
                <field name="rear_wheels_id" string="Wheel Configuration"
                       filter_domain="[('rear_wheels_id','ilike', self)]"/>
                <group>
                    <filter string="Make" name="make_id" domain="[]" context="{'group_by':'make_id'}"/>
                    <filter string="Model" name="model_id" domain="[]" context="{'group_by':'model_id'}"/>
                    <filter string="year" name="year_id" domain="[]" context="{'group_by':'year_id'}"/>
                    <filter string="Submodel" name="submodel_id" domain="[]" context="{'group_by':'submodel_id'}"/>
                    <filter string="Wheel Configuration" name="rear_wheels_id" domain="[]"
                            context="{'group_by':'rear_wheels_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fitment_master_action" model="ir.actions.act_window">
        <field name="name">Fitment Master</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fitment.master</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitment_master_search"/>
    </record>

    <!-- customer.product.master -->
    <record id="customer_product_master_form_view" model="ir.ui.view">
        <field name="name">customer.product.master.form</field>
        <field name="model">customer.product.master</field>
        <field name="arch" type="xml">
            <form string="Customer Product Master">
                <sheet>
                    <group>
                        <group>
                            <field name="cpm_validation_id" required="1" options="{'no_create': True}"/>
                            <field name="product_id" required="1"/>
                            <field name="product_template_id" force_save="1"/>
                            <field name="part_terminology"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page name="Fitments" string="Fitments">
                            <field name="fitment_ids" required="1">
                                <list string="Fitment Master" create="0">
                                    <field name="make_id" required="1"/>
                                    <field name="model_id" required="1"/>
                                    <field name="year_id" required="1"/>
                                    <field name="submodel_id"/>
                                    <field name="rear_wheels_id"/>
                                    <field name="generation"/>
                                    <field name="fitment_class"/>
                                    <field name="vehicle_platform_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="customer_product_master_tree_view" model="ir.ui.view">
        <field name="name">customer.product.master.tree</field>
        <field name="model">customer.product.master</field>
        <field name="arch" type="xml">
            <list string="Customer Product Master" duplicate="0">
                <field name="cpm_validation_id"/>
                <field name="product_id"/>
                <field name="company_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_customer_product_master_search" model="ir.ui.view">
        <field name="name">customer.product.master.search</field>
        <field name="model">customer.product.master</field>
        <field name="arch" type="xml">
            <search string="Product Fitment Mapping">
                <field name="cpm_validation_id" string="Brand/Customer Code" filter_domain="[('cpm_validation_id','ilike', self)]"/>
                <field name="product_id" string="Product" filter_domain="[('product_id','ilike', self)]"/>
                <field name="fitment_ids" string="Make" filter_domain="[('fitment_ids.make_id.name', 'ilike', self)]"/>
                <field name="fitment_ids" string="Model" filter_domain="[('fitment_ids.model_id.name', 'ilike', self)]"/>
                <field name="fitment_ids" string="Year" filter_domain="[('fitment_ids.year_id.name', 'ilike', self)]"/>
                <field name="fitment_ids" string="Submodel" filter_domain="[('fitment_ids.submodel_id.name', 'ilike', self)]"/>
                <field name="fitment_ids" string="Wheel Configuration" filter_domain="[('fitment_ids.rear_wheels_id.name', 'ilike', self)]"/>
                 <group>
                    <filter string="Brand/Customer Code" name="make_idcpm_validation_ids" context="{'group_by':'cpm_validation_id'}"/>
                    <filter string="Product" name="product_id" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="customer_product_master_action" model="ir.actions.act_window">
        <field name="name">Product Fitment Mapping</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">customer.product.master</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_product_master_search"/>
    </record>

    <menuitem id="menu_customer_product_master"
              name="Product Fitment Mapping"
              action="customer_product_master_action"
              parent="menu_mmyauto_apps" sequence="77"/>
</odoo>
