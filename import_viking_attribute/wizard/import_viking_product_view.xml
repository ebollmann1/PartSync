<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_import_viking_product" model="ir.ui.view">
        <field name="name">import.viking.product.form</field>
        <field name="model">import.viking.product</field>
        <field name="arch" type="xml">
            <form string="Import Viking Product">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename"/>
                </group>

                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_viking_product" model="ir.actions.act_window">
        <field name="name">Import Viking Product Attribute</field>
        <field name="res_model">import.viking.product</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="ecom_import_attribute" parent="sale.product_menu_catalog" action="action_import_viking_product" sequence="5"/>
</odoo>
