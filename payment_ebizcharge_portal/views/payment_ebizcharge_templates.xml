<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="total_inh_confirmation" inherit_id="website_sale.confirmation">
        <xpath expr="//div[@id='oe_structure_website_sale_confirmation_2']" position="inside">
            <table class="table">
                <tbody>
                    <t t-set="tx_su" t-value="order.get_portal_last_transaction()"/>
                    <tr t-if="tx_su">
                        <td colspan="2" class="ps-0">
                            <t t-esc="tx_su.provider_id.name"/>
                        </td>
                        <td class="text-end pe-0" width="100">
                            <strong>Total:</strong>
                        </td>
                        <t t-if="allow_pay_surcharge">
                            <td class="text-end pe-0" width="100">
                                <strong t-esc="tx_su.amount + surcharge_amount"
                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                        </t>
                        <t t-else="">
                            <td class="text-end pe-0" width="100">
                                <strong t-field="tx_su.amount"
                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>

    <template id="total_inh" inherit_id="website_sale.total">

        <xpath expr="//table/tr[@name='o_order_total_taxes']" position="replace">
            <tr t-if="allow_pay_surcharge">
                <td
                        class="border-0 pb-2 ps-0 pt-0 text-start text-muted"
                        colspan="2">
                    Surcharge %
                </td>
                <td class="text-end border-0 pb-2 pe-0 pt-0">
                    <span t-esc="surcharge_percent"
                          style="white-space: nowrap;"
                          t-options='{"widget": "float", "precision": 2}'/>%
                </td>

            </tr>
            <tr t-if="allow_pay_surcharge">
                <input id="allow_pay_surcharge" type='hidden' name='allow_pay_surcharge'
                       t-att-value='allow_pay_surcharge'/>
                <td class="border-0 pb-2 ps-0 pt-0 text-start text-muted" colspan="2">Surcharge Amount</td>
                <td class="text-end border-0 pb-2 pe-0 pt-0">
                    <span t-esc="website_sale_order.currency_id.symbol"/>&#160;<span id="sur_amt_ebiz"
                                                                                     t-esc="surcharge_amount"
                                                                                     class="monetary_field"
                                                                                     t-options='{"widget": "float", "precision": 2}'
                                                                                     style="white-space: nowrap;"
                />
                    <span id="surcharge_loading" class="d-none spinner-border spinner-border-sm ms-1" role="status"/>
                </td>
            </tr>
            <tr name="o_order_total_taxes">
                <td colspan="2" class="text-muted border-0 p-0 pe-3 pb-2">Taxes</td>
                <td class="text-end border-0 p-0 ps-3 pb-2">
                    <span t-field="website_sale_order.amount_tax"
                          class="monetary_field"
                          style="white-space: nowrap;"
                          t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                </td>
            </tr>
        </xpath>
        <xpath expr="//table/tr[@name='o_order_total']" position="replace">
            <tr name="o_order_total" class="border-top">
                <td colspan="2" class="border-0 ps-0 pt-2">
                    <strong>Total</strong>
                </td>
                <t t-if="allow_pay_surcharge">
                    <input id="total_order_amt_ebiz" type="hidden" name="total_order_amt_ebiz"
                           t-att-value="website_sale_order.amount_total"/>
                    <td class="text-end border-0 px-0 pt-2">
                        <t t-if="is_add_surcharge">
                            <strong t-field="website_sale_order.currency_id.symbol"/>&#160;
                            <strong t-esc="website_sale_order.amount_total + surcharge_amount"
                                    t-options='{"widget": "float", "precision": 2}'/>
                        </t>
                        <t t-else="">
                            <strong t-field="website_sale_order.currency_id.symbol"/>&#160;
                            <strong id="sur_amt_ebiz_total"
                                    t-esc="website_sale_order.amount_total"
                                    t-options='{"widget": "float", "precision": 2}'/>
                        </t>
                    </td>
                </t>
                <t t-else="">
                    <td class="text-end border-0 px-0 pt-2">
                        <strong t-field="website_sale_order.amount_total"
                                class="monetary_field text-end p-0"
                                t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                    </td>
                </t>
            </tr>
        </xpath>
    </template>

    <template id="method_form_ebiz" inherit_id="payment.method_form">
        <xpath expr="//div[@name='o_payment_tokenize_container']" position='attributes'>
            <attribute name="t-if">pm_sudo.code != 'ebizcharge'</attribute>
        </xpath>
        <xpath expr="//div[@name='o_payment_inline_form']//div" position='before'>
            <t t-if="pm_sudo.code=='ebizcharge'">
                <div class="tabbable">
                    <input type="hidden" name="payment_type" class="form-control"/>
                    <input type="hidden" name="addCardBank" class="form-control"/>
                    <input type="hidden" name="showACH" class="form-control" t-att-value="showACH"/>
                    <input type="hidden" name="authOnly" class="form-control" t-att-value="authOnly"/>
                    <input type="hidden" name="showCreditCards" class="form-control" t-att-value="showCreditCards"/>
                    <input type="hidden" name="update_pm_id" id="update_pm_id" class="form-control"/>
                    <input type="hidden" name="is_ebiz_manage_screen" id="is_ebiz_manage_screen" t-att-value="false"/>
                    <t t-set="providers_ebiz_count" t-value="len(providers_ebiz) if providers_ebiz else 0"/>
                    <t t-set="provider"
                       t-value="request.env['payment.provider'].sudo().search([('code', '=', 'ebizcharge'), ('company_id', '=', request.env.company.id)], limit=1)"/>

                    <ul class="nav nav-tabs">
                        <t t-call="payment_ebizcharge_portal.parent_nav_items"/>
                    </ul>
                    <div class="tab-content mt16">
                        <t t-if="showCreditCards == True" t-call="payment_ebizcharge_portal.tab_pane_credit_card"/>
                        <t t-if="showACH == True" t-call="payment_ebizcharge_portal.tab_pane_bank_accounts"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="parent_nav_items" name="EbizCharge Parent Nav Items">
        <input type="hidden" class="change_new_account_val" id="new_account_tab_id_val"
               t-att-value="'new_card_val' if showCreditCards else 'new_account_val'"/>
        <li t-if="showCreditCards == True" class="nav-item active">
            <a class="nav-link active parent-tab" id="credit-tab" data-bs-toggle="tab" href="#CreditCardId"
               role="tab" aria-controls="credit" aria-selected="true">Credit Card
            </a>
        </li>
        <li t-if="showACH == True and authOnly==False"
            t-att-class="'nav-item active' if showCreditCards == False else 'nav-item'">
            <a t-att-class="'nav-link active parent-tab' if showCreditCards == False else 'nav-link parent-tab'"
               id="account-tab" data-bs-toggle="tab" href="#saveAccountsDetails"
               role="tab" aria-controls="account" aria-selected="false">Bank Accounts
            </a>
        </li>
    </template>

    <template id="nav_items_bank_accounts" name="EbizCharge Nav Items Bank Accounts">
        <ul t-if="showACH == True and authOnly==False" class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active o_payment_provider_select new_payment_type new_account_tab_value"
                   id="new-account-tab" name="new-account-tab"
                   data-bs-toggle="tab" href="#addBankAccountDetails" role="tabpanel"
                   aria-labelledby="account-tab" aria-selected="false">New Bank Account
                </a>
            </li>
            <li class="nav-item" t-if="logIn == True">
                <a class="nav-link o_payment_provider_select" id="save-account-tab"
                   data-bs-toggle="tab" href="#saveAccountsDetailstab" role="tabpanel"
                   aria-labelledby="account-tab" aria-selected="true">Saved Bank Account
                </a>
            </li>
        </ul>
    </template>

    <template id="tab_pane_bank_accounts" name="EbizCharge Tab Pane Bank Accounts">
        <div t-att-class="'tab-pane active' if showCreditCards == False else 'tab-pane'"
             id="saveAccountsDetails">
            <t t-call="payment_ebizcharge_portal.nav_items_bank_accounts"/>
            <div class="tab-content">
                <div class="tab-pane" id="saveAccountsDetailstab"
                     aria-labelledby="save-account-tab">
                    <t t-call="payment_ebizcharge_portal.ebiz_saved_bank_accounts_table"/>
                </div>
                <t t-call="payment_ebizcharge_portal.ebiz_new_bank_account_form"/>
            </div>
        </div>
    </template>

    <template id="surcharge_terms_notice">
        <t t-if="is_sur_able">
            <div class="alert alert-info fw-bold d-flex align-items-center" role="alert" style="max-width: fit-content; font-weight: 700; font-size: 13px; line-height: 1.4; padding: 8px 12px; border-radius: 4px; margin: 8px 0;">
                <span t-esc="surcharge_terms"/>
            </div>
        </t>
    </template>

    <template id="ebiz_saved_bank_accounts_table">
        <div t-if="showACH == True and authOnly == False and logIn == True"
             class="card-body" id="BankAccountsDetails">
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th scope="col">Name on Account</th>
                        <th scope="col">Account Type &amp; Number</th>
                        <th scope="col text-center">Default Payment Method</th>
                        <th t-if="mode == 'manage'" scope="col" class="text-center">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="ebiz_tokens" t-as="token">
                        <t t-if="token.token_type == 'ach' and token.provider_id.code == 'ebizcharge'">
                            <tr class="o_payment_provider_select">
                                <td>
                                    <label style="width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        <input name="o_payment_radio"
                                               type="radio"
                                               id="o_payment_radio_id"
                                               t-att-checked="token.id == default_payment_option_id"
                                               t-att-data-payment-option-id="token.id"
                                               t-att-data-provider-code="token.provider_code"
                                               data-payment-option-type="token"
                                               t-att-value="'%s-%s' % (token.id, 'ebizchargeAccount')"/>
                                        <span class="payment_option_name"
                                              t-esc="token.account_holder_name"/>
                                        <input type="hidden"
                                               name="account_acquirer_name"
                                               id="account_acquirer_name"
                                               class="form-control"
                                               t-att-value="token.provider_id.code"/>
                                    </label>
                                </td>
                                <td>
                                    <label>
                                        <i class="fa fa-bank fa-lg text-muted"
                                           role="img">
                                            <span class="payment_option_name"
                                                  t-esc="token.account_number_ecom"/>
                                        </i>
                                    </label>
                                </td>
                                <td class="text-center">
                                    <label>
                                        <t t-if="token.is_default">
                                            <i class="fa fa-check fa-lg text-success"
                                               title="This payment method is set as a default payment method."
                                               role="img" aria-label="Ok"></i>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-check fa-lg text-muted"
                                               title="This payment method has not been verified by our system."
                                               role="img" aria-label="Not verified"></i>
                                        </t>
                                    </label>
                                </td>
                                <td t-if="mode == 'manage'" class="mt-1 text-center d-flex"
                                    style="width:120px">
                                    <button style="background-color: none; border: none;"
                                            t-if="mode == 'manage' and token.ebizcharge_profile != false"
                                            name="update_pm" t-att-value="token.id"
                                            class="btn btn-outline-primary mr-2 update_pm">
                                        <i class="fa fa-pencil fa-lg"></i>
                                    </button>
                                    <button style="background-color: none; border: none;"
                                            t-if="mode == 'manage'"
                                            name="delete_ebiz_pm" t-att-value="token.id"
                                            class="btn btn-outline-primary delete_pm">
                                        <i class="fa fa-trash fa-lg"></i>
                                    </button>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>
    </template>

    <template id="ebiz_new_bank_account_form">
        <div class="tab-pane active" id="addBankAccountDetails">
            <div t-if="showACH == True"
                 class="box ml16 mt16 mr16 bootstrap_formatting tab-pane"
                 aria-labelledby="new-account-tab" id="addBankAccountDetails">
                <div class="row" style="padding:10px;">
                    <div class="col form-group col-md-4 bank_account_holder_name">
                        <input type="text" name="bank_account_holder_name"
                               id="bank_account_holder_name" class="form-control"
                               placeholder="Account Holder Name 1" maxlength="50"
                               data-is-required="true" required="1"/>
                    </div>
                    <div class="col form-group col-md-4 bank-account-type">
                        <select name="bank_account_type" id="bank_account_type"
                                class="form-select form-control" required="1" data-is-required="true">
                            <option value="" selected="" hidden="">Account Type</option>
                            <option value="Checking">Checking</option>
                            <option value="Savings">Savings</option>
                        </select>
                    </div>
                </div>
                <div class="row" style="padding:10px;">
                    <div class="col form-group col-md-4 account-number">
                        <input type="text" name="account_number" id="account_number"
                               class="form-control"
                               placeholder="Account Number" data-is-required="true"
                               required="1"/>
                        <div class="bank_placeholder"></div>
                    </div>
                    <div class="col form-group col-md-4 confirm-account-number">
                        <input type="text" name="confirm_account_number" id="confirm_account_number"
                               class="form-control js_confirm_field" data-bs-toggle="tooltip"
                               data-bs-trigger="manual"
                               title="Account number does not match." data-confirm-id="account_number"
                               data-bs-delay="0"
                               placeholder="Confirm Account Number" data-is-required="true"
                               t-att-show="'do-not-show'"
                               required="1"/>
                    </div>
                </div>
                <div class="row" style="padding:10px;">
                    <div class="col form-group col-md-4 routing-number">
                        <input type="text" name="routing_number" id="routing_number"
                               class="form-control"
                               placeholder="Routing Number" data-is-required="true"
                               required="1"/>
                    </div>
                    <div class="col form-group col-md-4 confirm-routing-number">
                        <input type="text" name="confirm_routing_number" id="confirm_routing_number"
                               class="form-control js_confirm_field" data-bs-toggle="tooltip"
                               data-bs-trigger="manual"
                               title="Routing number does not match." data-confirm-id="routing_number"
                               placeholder="Confirm Routing Number" data-is-required="true"
                               t-att-show="'do-not-show'"
                               required="1"/>
                    </div>
                </div>
                <t t-set="tokenization_required"
                   t-value="provider._is_tokenization_required(provider=provider.code)"/>
                <div t-if="logIn == True" class="form-group col-md-8">
                    <div class="row">
                        <label>
                            <input class="token_box_ach_vals" id="token_save_box_acc"
                                   name="o_payment_save_as_token" type="checkbox"/>
                            Save my payment details
                        </label>
                    </div>
                    <div class="row">
                        <label>
                            <input type="checkbox" class="default_check"
                                   name="default_account_method"
                                   id="default_account_method"/>
                            Make default payment method
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="nav_items_credit_card" name="EbizCharge Nav Items Credit Card">
        <ul t-if="showCreditCards == True" class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active o_payment_provider_select o_payment_provider_select_cc new_payment_type"
                   id="new-card-tab" data-bs-toggle="tab"
                   href="#addCardDetails" role="tabpanel" aria-labelledby="credit-tab"
                   aria-selected="true">New Card
                </a>
            </li>
            <li class="nav-item" t-if="logIn == True">
                <a class="nav-link o_payment_provider_select o_payment_provider_select_cc"
                   id="save-card-tab" data-bs-toggle="tab" href="#saveCreditCardsDetails"
                   role="tabpanel" aria-labelledby="credit-tab" aria-selected="false">Saved Cards
                </a>
            </li>
        </ul>
    </template>

    <template id="tab_pane_new_card" name="EbizCharge Tab Pane New Card">
        <div t-if="showCreditCards == True" class="tab-pane active" id="addCardDetails">
            <t t-call="payment_ebizcharge_portal.surcharge_terms_notice"/>
            <div t-if="showCreditCards == True" class="box ml16 mt16 mr16 tab-pane"
                 aria-labelledby="new-card-tab" id="addCardDetails">
                <div class="row" style="padding:10px;">
                    <div class="col form-group col-md-6 card_number">
                        <input type="text" name="card_number" id="cc_number"
                               class="form-control surcharge_calc" placeholder="Card Number"
                               data-is-required="true" required="1"/>
                        <span id="creditcard-keyup"></span>
                        <div class="card_placeholder"></div>
                        <div class="visa"></div>
                        <input type="hidden" name="cc_brand" value=""/>
                    </div>
                    <div class="col form-group col-md-6 cc_holder_name">
                        <input type="text" name="account_holder_name" id="cc_holder_name"
                               class="form-control"
                               placeholder="Cardholder Name" maxlength="50"
                               data-is-required="true" required="1"/>
                    </div>
                </div>
                <div class="row" style="padding:10px;">
                    <div class="col form-group col-md-6 avs-street">
                        <input type="text" name="avs_street" id="avs_street"
                               class="form-control"
                               placeholder="Billing Address" data-is-required="true"
                               required="1"/>
                    </div>
                    <div class="col"
                         t-att-class="'form-group col-md-6' if bootstrap_formatting else 'form-group col-md-6 zip-code'">
                        <input type="text" name="avs_zip" id="avs_zip"
                               class="form-control surcharge_calc"
                               placeholder="Zip / Postal Code" maxlength="15"
                               data-is-required="true" required="1"/>
                    </div>
                </div>
                <div class="row" style="padding:10px;">
                    <div class="col form-group col-md-3 cc-expiry">
                        <input type="text" name="card_expiration" id="cc_expiry"
                               class="form-control"
                               placeholder="Expires (MM/YY)" data-is-required="true"
                               maxlength="7" required="1"/>
                        <span id="card_expiration-keyup"></span>
                    </div>
                    <div class="col form-group col-md-3">
                    </div>
                    <div class="col form-group col-md-3 cc-cvc">
                        <input type="text" name="card_code" id="cc_cvc" class="form-control"
                               maxlength="4" placeholder="CVC" data-is-required="true"
                               required="1"/>
                    </div>
                    <div class="col form-group col-md-3">
                    </div>
                </div>
                <t t-set="tokenization_required"
                   t-value="provider._is_tokenization_required(provider=provider.code)"/>
                <div t-if="logIn == True" class="form-group col-md-8">
                    <div class="row">
                        <label>
                            <input class="token_box_credit_vals" id="token_save_box_credit"
                                   name="o_payment_save_as_token" type="checkbox"/>
                            Save my payment details
                        </label>
                    </div>
                    <div class="row">
                        <label>
                            <input type="checkbox" class="default_check"
                                   name="default_card_method" id="default_card_method"/>
                            Make default payment method
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="tab_pane_saved_cards" name="EbizCharge Tab Pane Saved Cards">
        <div class="tab-pane" id="saveCreditCardsDetails"
             aria-labelledby="save-card-tab">
            <t t-call="payment_ebizcharge_portal.surcharge_terms_notice"/>
            <div t-if="showCreditCards == True and logIn == True" class="card-body"
                 id="CreditCardsDetails">
                <table class="table table-borderless">
                    <thead>
                        <tr>
                            <th scope="col">Name on Card</th>
                            <th scope="col">Card Type &amp; Number</th>
                            <th scope="col">Expiration Date</th>
                            <th scope="col" class="text-center">Default Payment Method</th>
                            <th scope="col" class="text-center" id="security-code-heading"
                                style="display: none">Security Code
                            </th>
                            <th t-if="mode == 'manage'" scope="col" class="text-center">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="ebiz_tokens" t-as="token">
                            <t t-if="token.token_type == 'credit' and token.provider_id.code == 'ebizcharge'">
                                <tr class="o_payment_provider_select">
                                    <td>
                                        <label style="width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                            <input name="o_payment_radio"
                                                   type="radio"
                                                   t-att-checked="token.id == default_payment_option_id"
                                                   t-att-data-payment-option-id="token.id"
                                                   t-att-data-provider-code="token.provider_code"
                                                   data-payment-option-type="token"
                                                   t-att-data-card-type="token.card_type"
                                                   t-att-value="'%s-%s' % (token.id, 'ebizchargeCard')"/>
                                            <span class="payment_option_name"
                                                  t-esc="token.account_holder_name"/>
                                            <input type="hidden" name="card_acquirer_name"
                                                   id="card_acquirer_name" class="form-control"
                                                   t-att-value="token.provider_id.code"/>
                                        </label>
                                    </td>
                                    <td>
                                        <label>
                                            <span t-if="token.image and token.card_type == 'M'"
                                                  style="font-size:24px;color:#000080"
                                                  class="fa fa-cc-mastercard"/>
                                            <span t-if="token.image and token.card_type == 'V'"
                                                  style="font-size:24px;color:#000080"
                                                  class="fa fa-cc-visa"/>
                                            <span t-if="token.image and token.card_type == 'A'"
                                                  style="font-size:24px;color:#000080"
                                                  class="fa fa-cc-amex"/>
                                            <span t-if="token.image and token.card_type == 'DN'"
                                                  style="font-size:24px;color:#000080"
                                                  class="fa fa-cc-diners-club"/>
                                            <span t-if="token.image and token.card_type == 'J'"
                                                  style="font-size:24px;color:#000080"
                                                  class="fa fa-cc-jcb"/>
                                            <span t-if="token.image and token.card_type == 'DS'"
                                                  style="font-size:24px;color:#000080"
                                                  class="fa fa-cc-discover"/>
                                            <span t-field="token.card_number_ecom"/>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <label>
                                            <span class="payment_option_name"
                                                  t-esc="token.card_exp_date"/>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <label>
                                            <t t-if="token.is_default">
                                                <i class="fa fa-check fa-lg text-success"
                                                   title="This payment method is set as a default payment method."
                                                   role="img" aria-label="Ok"></i>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-check fa-lg text-muted"
                                                   title="This payment method has not been verified by our system."
                                                   role="img" aria-label="Not verified"></i>
                                            </t>
                                        </label>
                                    </td>
                                    <td style="margin: auto; padding: 0px;" class="form-group">
                                        <input type="text" id="ebiz_saved_security_code"
                                               name="security-code"
                                               class="form-control security-code" maxlength="4"
                                               t-att-id="token.id"
                                               style="margin: auto;display:none; border: 0; outline: 0; border-bottom: 1px solid black;"/>
                                    </td>
                                    <td t-if="mode == 'manage'" class="mt-1 text-center d-flex"
                                        style="width:120px">
                                        <button style="background-color: none; border: none;"
                                                t-if="mode == 'manage' and token.ebizcharge_profile != false"
                                                name="update_pm" t-att-value="token.id"
                                                class="btn btn-outline-primary mr-2 update_pm">
                                            <i class="fa fa-pencil fa-lg"></i>
                                        </button>
                                        <button style="background-color: none; border: none;"
                                                t-if="mode == 'manage'" name="delete_ebiz_pm"
                                                t-att-value="token.id"
                                                class="btn btn-outline-primary delete_pm">
                                            <i class="fa fa-trash fa-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </template>

    <template id="tab_pane_credit_card" name="EbizCharge Tab Pane Credit Card">
        <div class="tab-pane active" id="CreditCardId">
            <t t-call="payment_ebizcharge_portal.nav_items_credit_card"/>
            <div class="tab-content">
                <t t-call="payment_ebizcharge_portal.tab_pane_new_card"/>
                <t t-call="payment_ebizcharge_portal.tab_pane_saved_cards"/>
            </div>
        </div>
    </template>

</odoo>
