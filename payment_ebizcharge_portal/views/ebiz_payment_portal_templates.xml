<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Portal home: EBizCharge Payment Methods entry -->
        <template id="portal_my_home_payment_ebiz" name="Show Borrows" customize_show="True"
                  inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-if="methods_allowing_tokenization or existing_tokens" t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/payment/static/img/payment-methods.svg'"/>
                    <t t-set="title">EBizCharge Payment methods</t>
                    <t t-set="text">Manage your payment methods</t>
                    <t t-set="url" t-value="'/my/ebiz_payment_method'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </xpath>
        </template>

        <!-- Hide standard Odoo "Payment Methods" entry when EBizCharge is the only active provider -->
        <template id="portal_my_home_payment_ebiz_condition" inherit_id="payment.portal_my_home_payment">
            <xpath expr="//t[@t-call='portal.portal_docs_entry']" position="attributes">
                <attribute name="t-if">(methods_allowing_tokenization or existing_tokens) and (not ebizcharge_active or has_other_providers)</attribute>
            </xpath>
        </template>

        <!-- ================================================================
             MANAGE PAGE SUB-TEMPLATES  (/my/ebiz_payment_method)
             ================================================================ -->

        <!-- Add Card / Add Account nav tabs -->
        <template id="portal_manage_nav_tabs" name="Portal Manage Nav Tabs">
            <ul class="nav nav-tabs" id="manageTab" role="tablist">
                <li t-if="showCreditCards" class="nav-item" role="presentation">
                    <a class="nav-link active" id="card-tab" data-bs-toggle="tab"
                       href="#addCardDetails" role="tab" aria-selected="true">
                        Add Card
                    </a>
                </li>
                <li t-if="showACH and logIn" class="nav-item" role="presentation">
                    <a class="nav-link" id="account-tab" data-bs-toggle="tab"
                       href="#addBankAccountDetails" role="tab" aria-selected="false">
                        Add Account
                    </a>
                </li>
            </ul>
        </template>

        <!-- New card form -->
        <template id="portal_manage_credit_card_form" name="Portal Manage Credit Card Form">
            <div t-if="showCreditCards" class="tab-pane fade show active"
                 id="addCardDetails" role="tabpanel" aria-labelledby="card-tab">
                <div class="row g-3 p-3">
                    <div class="col-md-6 form-group card_number">
                        <input type="text" name="card_number" id="cc_number"
                               class="form-control" placeholder="Card Number"
                               data-is-required="true" required="1"/>
                        <span id="creditcard-keyup"/>
                        <div class="card_placeholder"/>
                        <div class="visa"/>
                        <input type="hidden" name="cc_brand" value=""/>
                    </div>
                    <div class="col-md-6 form-group cc_holder_name">
                        <input type="text" name="account_holder_name" id="cc_holder_name"
                               class="form-control" placeholder="Cardholder Name"
                               maxlength="50" data-is-required="true" required="1"/>
                    </div>
                    <div class="col-md-6 form-group avs-street">
                        <input type="text" name="avs_street" id="avs_street"
                               class="form-control" placeholder="Billing Address"
                               data-is-required="true" required="1"/>
                    </div>
                    <div class="col-md-6 form-group zip-code">
                        <input type="text" name="avs_zip" id="avs_zip"
                               class="form-control" placeholder="Zip / Postal Code"
                               maxlength="15" data-is-required="true" required="1"/>
                    </div>
                    <div class="col-md-3 form-group cc-expiry">
                        <input type="text" name="card_expiration" id="cc_expiry"
                               class="form-control" placeholder="Expires (MM/YY)"
                               data-is-required="true" maxlength="7" required="1"/>
                        <span id="card_expiration-keyup"/>
                    </div>
                    <div class="col-md-3 form-group cc-cvc">
                        <input type="text" name="card_code" id="cc_cvc"
                               class="form-control" maxlength="4" placeholder="CVC"
                               t-att-data-is-required="VerifyCreditCardBeforeSaving" required="1"/>
                    </div>
                    <input type="hidden" name="token_save_box_credit" id="token_save_box_credit" t-att-value="true"/>
                    <input type="hidden" id="verify_credit_card_before_saving" t-att-value="VerifyCreditCardBeforeSaving"/>
                    <input type="hidden" name="update_pm_id" id="update_pm_id" t-att-value="update_pm_id"/>
                    <t t-if="logIn">
                        <div class="col-12">
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="default_check"
                                       name="default_card_method" id="default_card_method"/>
                                Make default payment method
                            </label>
                        </div>
                    </t>
                </div>
            </div>
        </template>

        <!-- New bank account form -->
        <template id="portal_manage_bank_account_form" name="Portal Manage Bank Account Form">
            <div t-if="showACH and logIn" class="tab-pane fade"
                 id="addBankAccountDetails" role="tabpanel" aria-labelledby="account-tab">
                <div class="row g-3 p-3">
                    <div class="col-md-6 form-group bank_account_holder_name">
                        <input type="text" name="bank_account_holder_name"
                               id="bank_account_holder_name" class="form-control"
                               placeholder="Account Holder Name" maxlength="50"
                               data-is-required="true" required="1"/>
                    </div>
                    <div class="col-md-6 form-group bank-account-type">
                        <select name="bank_account_type" id="bank_account_type"
                                class="form-select" required="1" data-is-required="true">
                            <option value="" selected="" hidden="">Account Type</option>
                            <option value="Checking">Checking</option>
                            <option value="Savings">Savings</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group account-number">
                        <input type="text" name="account_number" id="account_number"
                               class="form-control" placeholder="Account Number"
                               data-is-required="true" required="1"/>
                        <div class="bank_placeholder"/>
                    </div>
                    <div class="col-md-6 form-group routing-number">
                        <input type="text" name="routing_number" id="routing_number"
                               class="form-control" placeholder="Routing Number"
                               data-is-required="true" required="1"/>
                    </div>
                    <input type="hidden" name="token_save_box_acc" id="token_save_box_acc" t-att-value="true"/>
                    <input type="hidden" name="update_pm_id" t-att-value="update_pm_id"/>
                    <t t-if="logIn">
                        <div class="col-12">
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="default_check"
                                       name="default_account_method" id="default_account_method"/>
                                Make default payment method
                            </label>
                        </div>
                    </t>
                </div>
            </div>
        </template>

        <!-- Save / Cancel / Show-Hide / Refresh buttons -->
        <template id="portal_manage_action_buttons" name="Portal Manage Action Buttons">
            <div class="d-flex align-items-center flex-wrap gap-2 p-3 border-top">
                <button name="ebiz_submit_button" id="add_new_ebiz_card"
                        class="btn btn-primary" type="submit">Save
                </button>
                <button name="ebiz_cancel_button" class="btn btn-secondary" type="button">
                    Cancel
                </button>
                <t t-if="logIn">
                    <button name="show_hide_tokens" type="button" class="btn btn-link ms-2">
                        Show/Hide Saved Payment Methods
                    </button>
                    <button name="refresh_payment_tokens" type="button"
                            class="btn btn-outline-secondary ms-auto">
                        <i class="fa fa-refresh me-1"/>Refresh Payment Methods
                    </button>
                </t>
            </div>
        </template>

        <!-- EBizCharge Credit Cards saved table -->
        <template id="portal_manage_credit_cards_table" name="Portal Manage Credit Cards Table">
            <t t-if="showCreditCards and logIn">
                <h6 id="CreditCards" class="px-3 pt-3 pb-2 mb-0 border-top fw-semibold text-muted">
                    <i class="fa fa-credit-card me-2"/>EBizCharge Credit Cards
                </h6>
                <div id="CreditCardsDetails" class="table-responsive px-2 pb-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name on Card</th>
                                <th scope="col">Card Type &amp; Number</th>
                                <th scope="col">Expiration Date</th>
                                <th scope="col" class="text-center">Default</th>
                                <th scope="col" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="tokens" t-as="token">
                                <t t-if="token.token_type == 'credit' and token.provider_id.code == 'ebizcharge'">
                                    <tr>
                                        <td>
                                            <span style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;">
                                                <input name="o_payment_radio" type="radio"
                                                       t-att-checked="token.id == default_payment_option_id"
                                                       t-att-data-payment-option-id="token.id"
                                                       t-att-data-provider="token.provider_code"
                                                       data-payment-option-type="token"
                                                       t-att-value="'%s-%s' % (token.id, 'ebizcharge')"
                                                       class="d-none"/>
                                                <input type="hidden" name="card_acquirer_name"
                                                       id="card_acquirer_name"
                                                       t-att-value="token.provider_id.code"/>
                                                <t t-esc="token.account_holder_name"/>
                                            </span>
                                        </td>
                                        <td>
                                            <span t-if="token.image and token.card_type == 'M'"
                                                  style="font-size:22px;color:#000080"
                                                  class="fa fa-cc-mastercard me-1"/>
                                            <span t-if="token.image and token.card_type == 'V'"
                                                  style="font-size:22px;color:#000080"
                                                  class="fa fa-cc-visa me-1"/>
                                            <span t-if="token.image and token.card_type == 'A'"
                                                  style="font-size:22px;color:#000080"
                                                  class="fa fa-cc-amex me-1"/>
                                            <span t-if="token.image and token.card_type == 'DN'"
                                                  style="font-size:22px;color:#000080"
                                                  class="fa fa-cc-diners-club me-1"/>
                                            <span t-if="token.image and token.card_type == 'J'"
                                                  style="font-size:22px;color:#000080"
                                                  class="fa fa-cc-jcb me-1"/>
                                            <span t-if="token.image and token.card_type == 'DS'"
                                                  style="font-size:22px;color:#000080"
                                                  class="fa fa-cc-discover me-1"/>
                                            <span t-field="token.card_number_ecom"/>
                                        </td>
                                        <td><t t-esc="token.card_exp_date"/></td>
                                        <td class="text-center">
                                            <i t-if="token.is_default"
                                               class="fa fa-check-circle fa-lg text-success"
                                               title="Default payment method"
                                               role="img" aria-label="Default"/>
                                            <i t-else=""
                                               class="fa fa-circle-o fa-lg text-muted"
                                               role="img" aria-label="Not default"/>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a t-if="token.ebizcharge_profile" href="#card-tab"
                                                   data-bs-toggle="tab">
                                                    <button class="btn btn-sm btn-outline-primary update_ebiz_card"
                                                            name="update_ebiz_card" t-att-value="token.id"
                                                            data-bs-toggle="tooltip" data-bs-placement="top"
                                                            title="Edit">
                                                        <i class="fa fa-pencil"/>
                                                    </button>
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger delete_cred_card delete_pm"
                                                        name="delete_ebiz_pm" t-att-value="token.id"
                                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                                        title="Delete">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <!-- EBizCharge Bank Accounts saved table -->
        <template id="portal_manage_bank_accounts_table" name="Portal Manage Bank Accounts Table">
            <t t-if="showACH and logIn">
                <h6 id="BankAccounts" class="px-3 pt-3 pb-2 mb-0 border-top fw-semibold text-muted">
                    <i class="fa fa-university me-2"/>EBizCharge Bank Accounts
                </h6>
                <div id="BankAccountsDetails" class="table-responsive px-2 pb-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name on Account</th>
                                <th scope="col">Account Type &amp; Number</th>
                                <th scope="col" class="text-center">Default</th>
                                <th scope="col" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="tokens" t-as="token">
                                <t t-if="token.token_type == 'ach' and token.provider_id.code == 'ebizcharge'">
                                    <tr>
                                        <td>
                                            <span style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;">
                                                <input name="o_payment_radio" type="radio"
                                                       t-att-checked="token.id == default_payment_option_id"
                                                       t-att-data-payment-option-id="token.id"
                                                       t-att-data-provider="token.provider_code"
                                                       data-payment-option-type="token"
                                                       class="d-none"/>
                                                <input type="hidden" name="account_acquirer_name"
                                                       id="account_acquirer_name"
                                                       t-att-value="token.provider_id.code"/>
                                                <t t-esc="token.account_holder_name"/>
                                            </span>
                                        </td>
                                        <td>
                                            <i class="fa fa-university fa-lg text-muted me-1" role="img"/>
                                            <span t-esc="token.account_number_ecom"/>
                                        </td>
                                        <td class="text-center">
                                            <i t-if="token.is_default"
                                               class="fa fa-check-circle fa-lg text-success"
                                               title="Default payment method"
                                               role="img" aria-label="Default"/>
                                            <i t-else=""
                                               class="fa fa-circle-o fa-lg text-muted"
                                               role="img" aria-label="Not default"/>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a t-if="token.ebizcharge_profile" href="#account-tab"
                                                   data-bs-toggle="tab">
                                                    <button class="btn btn-sm btn-outline-primary update_ebiz_account"
                                                            name="update_ebiz_account" t-att-value="token.id"
                                                            data-bs-toggle="tooltip" data-bs-placement="top"
                                                            title="Edit">
                                                        <i class="fa fa-pencil"/>
                                                    </button>
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger delete_bank_acc delete_pm"
                                                        name="delete_ebiz_pm" t-att-value="token.id"
                                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                                        title="Delete">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <!-- Main payment methods page (/my/ebiz_payment_method) -->
        <template id="payment_ebizcharge_portal.payment_methods" name="Payment Methods">
            <t t-call="portal.frontend_layout">
                <t t-set="page_title" t-value="'Payment Methods'"/>
                <t t-set="additional_title"><t t-esc="page_title"/></t>
                <div id="o_ebiz_payment_form" class="wrap">
                    <div class="container py-4">
                        <t t-call="payment.portal_breadcrumb"/>
                        <div class="row justify-content-center">
                            <div class="col-lg-9">

                                <!-- Hidden form state -->
                                <input type="hidden" name="data_set"
                                       data-create-route="/payment/ebizcharge/s2s/create_json_3ds"/>
                                <input type="hidden" name="provider_id" t-att-value="id"/>
                                <input type="hidden" name="providerid" id="ebiz_provider_id" t-att-value="providerid"/>
                                <input type="hidden" id="new_account_tab_id" name="new_account_tab"
                                       t-att-value="'new_card' if showCreditCards else 'new_account'"/>
                                <input type="hidden" name="is_ebiz_manage_screen" id="is_ebiz_manage_screen" t-att-value="true"/>
                                <input type="hidden" name="addCardBank" class="form-control"/>
                                <input type="hidden" name="authorizeOnly" class="form-control" t-att-value="authOnly"/>
                                <input type="hidden" name="showCreditCards" class="form-control" t-att-value="showCreditCards"/>
                                <input type="hidden" name="card_type" id="card_type"/>
                                <input t-if="return_url" type="hidden" name="return_url" t-att-value="return_url"/>
                                <input t-if="partner_id" type="hidden" name="partner_id" t-att-value="partner_id"/>

                                <!-- Tab form card -->
                                <div class="card shadow-sm">
                                    <div class="card-header bg-white">
                                        <t t-call="payment_ebizcharge_portal.portal_manage_nav_tabs"/>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="tab-content">
                                            <t t-call="payment_ebizcharge_portal.portal_manage_credit_card_form"/>
                                            <t t-call="payment_ebizcharge_portal.portal_manage_bank_account_form"/>
                                        </div>
                                        <t t-call="payment_ebizcharge_portal.portal_manage_action_buttons"/>
                                        <t t-call="payment_ebizcharge_portal.portal_manage_credit_cards_table"/>
                                        <t t-call="payment_ebizcharge_portal.portal_manage_bank_accounts_table"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
